generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  // Alerts for new responses (SurveyMonkey "Alertas de respuestas").
  notifyResponses Boolean @default(true)
  createdAt    DateTime @default(now())

  surveys       Survey[]
  notifications Notification[]
  contacts      Contact[]
  contactGroups ContactGroup[]
  comments      SurveyComment[]
}

enum SurveyStatus {
  draft
  published
  closed
}

model Survey {
  id          String       @id @default(cuid())
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      SurveyStatus @default(draft)
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Design step: how the public survey looks and its intro/closing screens.
  themePreset          String  @default("modern") // modern | classic | futuristic | minimal | editorial | warm | vibrant
  themeColor           String  @default("#171717")
  backgroundColor      String  @default("#fafafa")
  colorMode            String  @default("light") // light | dark
  backgroundImageUrl   String?
  backgroundImageScope String  @default("all") // cover | all
  fontFamily           String  @default("system")
  buttonShape          String  @default("rounded") // rounded | pill | square
  surfaceStyle         String  @default("solid") // solid | transparent | blur | glass
  logoUrl              String?
  logoSize             Int     @default(120)
  logoPosition         String  @default("top-center") // top|bottom-left|center|right
  showProgress         Boolean @default(true)
  progressDisplay      String  @default("percentage") // percentage | questions | both | bar
  progressPosition     String  @default("top") // top | bottom
  showTitle            Boolean @default(false)
  showQuestionNumbers  Boolean @default(false)
  showRequiredAsterisk Boolean @default(false)
  advanceMode          String  @default("button") // tap | button

  welcomeEnabled     Boolean @default(false)
  welcomeTitle       String?
  welcomeText        String?
  welcomeButtonLabel String?

  thankYouTitle String?
  thankYouText  String?
  thankYouImageUrl  String?
  thankYouImageMode String @default("header") // header | background

  // Saved Análisis views (filters + compare groups), JSON array.
  analysisViews Json @default("[]")

  // Link preview (Open Graph) when the public link is shared.
  shareTitle       String?
  shareDescription String?
  shareImageUrl    String?

  // URL parameters captured with each response: [{ name, label? }].
  customVariables Json @default("[]")

  questions     Question[]
  edges         Edge[]
  responses     Response[]
  notifications Notification[]
  collectors    Collector[]
  questionGroups QuestionGroup[]
  comments      SurveyComment[]
}

enum QuestionType {
  single_choice
  multi_choice
  dropdown
  dropdown_matrix
  image_choice
  text
  short_text
  multiple_text
  rating
  slider
  ranking
  rating_matrix
  best_worst
  name
  email
  phone
  address
  datetime
}

model Question {
  id                    String       @id @default(cuid())
  surveyId              String
  survey                Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  // Canvas group ("Datos personales", …) the card belongs to, if any.
  groupId               String?
  group                 QuestionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  type                  QuestionType
  title                 String
  options               Json? // array of { value, label, isCorrect?, points? } for choice types
  positionX             Float        @default(0)
  positionY             Float        @default(0)
  isRoot                Boolean      @default(false)
  required              Boolean      @default(true)
  scoringEnabled        Boolean      @default(false)
  minSelections         Int?
  maxSelections         Int?
  selectionErrorMessage String?
  requiredErrorMessage  String?
  description           String?
  randomizeOptions      Boolean      @default(false)
  orderMode             String? // "random" | "alphabetical" | "flip"; null = random
  keepLastOption        Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  outgoingEdges Edge[]   @relation("SourceQuestion")
  incomingEdges Edge[]   @relation("TargetQuestion")
  answers       Answer[]

  @@index([surveyId])
}

model Edge {
  id                String   @id @default(cuid())
  surveyId          String
  survey            Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  sourceQuestionId  String
  sourceQuestion    Question @relation("SourceQuestion", fields: [sourceQuestionId], references: [id], onDelete: Cascade)
  targetQuestionId  String
  targetQuestion    Question @relation("TargetQuestion", fields: [targetQuestionId], references: [id], onDelete: Cascade)
  sourceOptionValue String? // null = default/next edge; non-null = conditional branch tied to this option value

  @@index([surveyId])
  @@index([sourceQuestionId])
}

model Response {
  id          String    @id @default(cuid())
  surveyId    String
  survey      Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  // Collector (link) the respondent came through; null once that collector is deleted.
  collectorId String?
  collector   Collector? @relation(fields: [collectorId], references: [id], onDelete: SetNull)
  // Respondent reached a "Descalificar" destination (kept apart from real results).
  disqualified Boolean   @default(false)
  // Values of the survey's custom variables read from the link, { name: value }.
  variables    Json?

  answers Answer[]

  @@index([surveyId])
  @@index([collectorId])
}

model Answer {
  id         String   @id @default(cuid())
  responseId String
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      Json // string | string[] | number depending on question type
  createdAt  DateTime @default(now())

  @@unique([responseId, questionId])
  @@index([questionId])
}

// In-app notification center. new_responses rows are one per survey per day and keep a running
// count; once-only types (limit_reached) use day = "once".
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  surveyId  String
  survey    Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  type      String // new_responses | limit_reached
  day       String
  count     Int       @default(1)
  detail    String? // e.g. the collector's name for limit_reached
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, surveyId, type, day])
  @@index([userId, updatedAt])
}

// A way of reaching respondents (today: a web link). Each one has its own public URL, state,
// access rules and response count.
model Collector {
  id       String @id @default(cuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  name     String
  type     String @default("link") // link
  slug     String @unique
  status   String @default("open") // open | closed

  accessPassword String?
  responseLimit  Int?
  cutoffAt       DateTime?

  // After answering: redirect to this URL instead of staying on the thank-you screen.
  endRedirectUrl        String?
  // Disqualified respondents: custom message and/or redirect URL.
  disqualifyMessage     String?
  disqualifyRedirectUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses Response[]

  @@index([surveyId])
}

/// Address book entry (SurveyMonkey "Contactos").
model Contact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  firstName String?
  lastName  String?
  language  String?
  custom1   String?
  custom2   String?
  custom3   String?
  createdAt DateTime @default(now())

  groups ContactGroupMember[]

  @@unique([userId, email])
}

model ContactGroup {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  members ContactGroupMember[]

  @@unique([userId, name])
}

model ContactGroupMember {
  contactId String
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  groupId   String
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([contactId, groupId])
}

/// Notes left on a survey or one of its questions in the editor (SurveyMonkey "Comentarios").
model SurveyComment {
  id         String    @id @default(cuid())
  surveyId   String
  survey     Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questionId String? // null = the survey as a whole; no FK so a deleted question keeps its notes
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     SurveyComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    SurveyComment[] @relation("CommentReplies")
  body       String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([surveyId, questionId])
}

/// A named box on the canvas that holds several question cards and moves them together.
model QuestionGroup {
  id        String     @id @default(cuid())
  surveyId  String
  survey    Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  name      String
  color     String     @default("slate") // slate | blue | green | amber | rose | violet
  createdAt DateTime   @default(now())
  questions Question[]

  @@index([surveyId])
}
